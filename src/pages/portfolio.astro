---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ContactCta from '../components/ContactCta.astro';

const title = 'Наши проекты — разработка сайтов | Valore Agency';
const description =
  'Реальные проекты Valore Agency: Landing Page, многостраничные сайты и информационные порталы. Примеры дизайна, разработки и SEO-структуры.';
const canonical = 'https://valoreagency.net/portfolio';

const works = [
  {
    name: 'GameDaily',
    domain: 'gamedaily.ru',
    url: 'https://gamedaily.ru/',
    tag: 'Медиа-сайт · Разработка · SEO · Контентная архитектура',
    kind: 'Информационный портал',
    heading: 'Информационный портал об игровой индустрии',
    lead: 'GameDaily — контентный проект о видеоиграх и игровой индустрии: новости, материалы о новых играх, гайды и киберспорт.',
    text: 'Основная задача — масштабируемая архитектура, которая позволяет работать с большим количеством публикаций и постепенно расширять число тематических направлений.',
    done: [
      'главная страница с лентой публикаций',
      'тематические категории',
      'игровые новости',
      'материалы о новых играх',
      'гайды',
      'разделы о киберспорте',
      'структура внутренних страниц',
      'поиск по сайту',
      'навигация между публикациями',
      'архитектура для дальнейшего расширения',
      'адаптация под мобильные устройства',
      'SEO-структура контентного проекта',
    ],
    accent: 'var(--pink-soft)',
  },
  {
    name: '«Основы»',
    domain: 'kasparova-osnovi.ru',
    url: 'https://kasparova-osnovi.ru/',
    tag: 'Landing Page · UX/UI · Разработка',
    kind: 'Landing Page',
    heading: 'Landing Page психологического практикума',
    lead: 'Одностраничный сайт для авторского психологического практикума.',
    text: 'Задача — представить специалиста и программу, подробно объяснить формат практикума и последовательно привести пользователя к записи. Информация раскрывается постепенно: от первого знакомства с продуктом до программы, отзывов, стоимости и ответов на вопросы.',
    done: [
      'структура Landing Page',
      'первый экран с основным предложением',
      'презентация специалиста',
      'описание практикума',
      'программа',
      'блоки с преимуществами',
      'отзывы',
      'информация об участии',
      'частые вопросы',
      'несколько точек перехода к целевому действию',
      'адаптация под мобильные устройства',
    ],
    accent: 'var(--lime-soft)',
  },
  {
    name: 'Дарья Антонова',
    domain: 'psychologistdarya.online',
    url: 'https://psychologistdarya.online/',
    tag: 'Многостраничный сайт · UX/UI · Разработка · SEO',
    kind: 'Многостраничный сайт специалиста',
    heading: 'Сайт частного психолога',
    lead: 'Многостраничный сайт специалиста для представления услуг психолога и развития проекта через органический поиск и полезный контент.',
    text: 'В отличие от одностраничного Landing Page здесь полноценная структура с отдельными направлениями работы, информацией о специалисте и блогом. Такой формат позволяет постепенно добавлять новые страницы услуг и материалы, не перестраивая весь проект.',
    done: [
      'главная страница',
      'информация о специалисте',
      'структура услуг',
      'отдельные направления работы',
      'блог',
      'информационные материалы',
      'контактный раздел',
      'удобные способы связи',
      'адаптация под мобильные устройства',
      'структура для дальнейшего SEO-развития',
    ],
    accent: 'var(--gray-soft)',
  },
];

const factors = [
  'задачу бизнеса или проекта',
  'структуру страниц',
  'пользовательский путь',
  'понятность навигации',
  'отображение на мобильных устройствах',
  'целевые действия',
  'техническую реализацию',
  'возможность дальнейшего развития',
  'SEO, если органический поиск важен для проекта',
];

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Наши проекты — Valore Agency',
  description,
  url: canonical,
  hasPart: works.map((w) => ({
    '@type': 'WebSite',
    name: w.name,
    url: w.url,
    description: w.lead,
  })),
};
---

<Layout title={title} description={description} canonical={canonical}>
  <Breadcrumb items={[{ label: 'Главная', href: '/' }, { label: 'Наши проекты' }]} />

  <section class="hero hero--center">
    <div class="hero__blob hero__blob--lime"></div>
    <div class="hero__blob hero__blob--pink"></div>
    <div class="container hero__inner">
      <p class="eyebrow">Портфолио</p>
      <h1>Наши проекты</h1>
      <p class="hero__lead">
        Здесь мы показываем реальные запущенные сайты, над которыми работали: от Landing Page
        и сайтов специалистов до информационных проектов. Для каждого проекта рассказываем
        о его задаче, структуре и основных решениях.
      </p>
      <div class="hero__actions">
        <a href="https://t.me/Valoreagency" target="_blank" rel="nofollow noopener" class="btn btn--dark">Обсудить свой проект</a>
      </div>
    </div>
  </section>

  <section id="raboty">
    <div class="container">
      <p class="eyebrow">— Реализованные проекты</p>
      <h2 class="section-title">Сайты, которые уже работают</h2>

      <div class="cases">
        {
          works.map((w) => (
            <article class="case">
              <div class="case__cover" style={`background:${w.accent}`}>
                <span class="case__kind">{w.kind}</span>
                <span class="case__domain">{w.domain}</span>
              </div>
              <div class="case__body">
                <span class="case__tag">{w.tag}</span>
                <h3 class="case__title">{w.heading}</h3>
                <p class="case__lead">{w.lead}</p>
                <p class="case__text">{w.text}</p>
                <p class="case__subtitle">Что реализовано</p>
                <ul class="case__list">
                  {w.done.map((d) => <li>{d}</li>)}
                </ul>
                <a href={w.url} class="btn btn--ghost case__btn" target="_blank" rel="noopener">
                  Посмотреть сайт →
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="prose">
    <div class="container">
      <h2 class="section-title">Разные проекты требуют разного подхода</h2>
      <p>
        У каждого сайта своя задача. Для <strong>Landing Page</strong> важно сфокусировать
        пользователя на одном предложении и последовательно привести его к целевому действию.
      </p>
      <p>
        Для <strong>сайта специалиста</strong> важна полноценная структура, которая позволяет
        представить несколько услуг, сформировать доверие и постепенно развивать проект через
        новые страницы и контент.
      </p>
      <p>
        Для <strong>информационного портала</strong> на первый план выходит масштабируемость:
        работа с большим количеством рубрик, публикаций и постоянно обновляемой информацией.
      </p>
      <p>
        Поэтому мы не используем одну универсальную структуру для всех проектов. Сначала
        определяем задачу будущего сайта, а затем подбираем подходящую архитектуру,
        функциональность и дизайн.
      </p>
    </div>
  </section>

  <section id="podhod">
    <div class="container">
      <p class="eyebrow">— Что мы учитываем при разработке</p>
      <h2 class="section-title">Сайт — это не только его внешний вид</h2>
      <ul class="reasons">
        {factors.map((f) => <li>{f}</li>)}
      </ul>
      <p class="cases__note">
        Такой подход позволяет создавать сайты, которые можно использовать и развивать после
        запуска, а не только демонстрировать как красивый дизайн.
      </p>
    </div>
  </section>

  <section class="prose">
    <div class="container">
      <h2 class="section-title">Нужен сайт для вашего проекта?</h2>
      <p>
        Не обязательно искать в портфолио сайт точно из вашей отрасли. Структура и дизайн
        нового проекта разрабатываются исходя из конкретной задачи, аудитории и необходимого
        функционала.
      </p>
      <p>
        Расскажите, какой сайт вы хотите создать. Обсудим задачу и предложим подходящий
        вариант реализации. Подробнее об этапах работы — на странице
        <a href="/uslugi/sozdanie-sajtov">создание сайтов</a>.
      </p>
    </div>
  </section>

  <ContactCta
    title="Обсудим ваш проект"
    lead="Расскажите, какой сайт вам нужен и какую задачу он должен решать — ответим и предложим вариант реализации."
  />

  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
</Layout>

<style>
  .cases {
    display: grid;
    gap: 24px;
  }
  .case {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    display: grid;
    grid-template-columns: 280px 1fr;
  }
  .case__cover {
    min-width: 0;
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
  }
  .case__kind {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-60);
  }
  .case__domain {
    font-family: 'Unbounded', sans-serif;
    font-weight: 600;
    font-size: 19px;
    line-height: 1.3;
    word-break: break-word;
    color: var(--ink);
  }
  .case__body {
    min-width: 0;
    padding: 28px;
  }
  .case__tag {
    display: block;
    font-size: 12px;
    color: var(--ink-60);
    margin-bottom: 10px;
  }
  .case__title {
    font-size: 21px;
    font-weight: 600;
    margin-bottom: 12px;
  }
  .case__lead {
    font-size: 15px;
    margin-bottom: 10px;
  }
  .case__text {
    font-size: 15px;
    color: var(--ink-60);
    margin-bottom: 20px;
  }
  .case__subtitle {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-60);
    margin-bottom: 10px;
  }
  .case__list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 22px;
  }
  .case__list li {
    font-size: 13px;
    color: var(--ink-60);
    background: var(--gray-soft);
    border-radius: 8px;
    padding: 6px 10px;
  }
  .case__btn {
    display: inline-block;
  }
  .cases__note {
    max-width: 720px;
    margin-top: 20px;
    font-size: 15px;
    color: var(--ink-60);
  }
  .reasons {
    max-width: 720px;
    list-style: none;
    display: grid;
    gap: 14px;
  }
  .reasons li {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 16px 20px 16px 44px;
    font-size: 15px;
    color: var(--ink-60);
    position: relative;
  }
  .reasons li::before {
    content: '✓';
    position: absolute;
    left: 18px;
    color: var(--lime);
    font-weight: 700;
    font-size: 16px;
  }

  @media (max-width: 860px) {
    .case {
      grid-template-columns: 1fr;
    }
    .case__cover {
      padding: 24px;
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: 14px;
    }
    .case__body {
      padding: 24px;
    }
  }
</style>
