---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ContactCta from '../components/ContactCta.astro';

const title = 'Наши проекты — разработка сайтов | Valore Agency';
const description =
  'Реальные проекты Valore Agency: Landing Page, многостраничные сайты и информационные порталы. Примеры дизайна, разработки и SEO-структуры.';
const canonical = 'https://valoreagency.net/portfolio/';

const works = [
  {
    name: 'GameDaily',
    domain: 'gamedaily.ru',
    shot: '/portfolio/gamedaily.jpg',
    url: 'https://gamedaily.ru/',
    tag: 'Медиа-сайт · Разработка · SEO · Контентная архитектура',
    heading: 'Информационный портал об игровой индустрии',
    lead: 'GameDaily — контентный проект о видеоиграх и игровой индустрии: новости, материалы о новых играх, гайды и киберспорт.',
    text: 'Основная задача — масштабируемая архитектура, которая позволяет работать с большим количеством публикаций и постепенно расширять число тематических направлений.',
    done: [
      'главная страница с лентой публикаций',
      'тематические категории',
      'игровые новости',
      'материалы о новых играх',
      'гайды',
      'разделы о киберспорте',
      'структура внутренних страниц',
      'поиск по сайту',
      'навигация между публикациями',
      'архитектура для дальнейшего расширения',
      'адаптация под мобильные устройства',
      'SEO-структура контентного проекта',
    ],
    accent: 'var(--pink-soft)',
  },
  {
    name: '«Основы»',
    domain: 'kasparova-osnovi.ru',
    shot: '/portfolio/kasparova.jpg',
    url: 'https://kasparova-osnovi.ru/',
    tag: 'Landing Page · UX/UI · Разработка',
    heading: 'Landing Page психологического практикума',
    lead: 'Одностраничный сайт для авторского психологического практикума.',
    text: 'Задача — представить специалиста и программу, подробно объяснить формат практикума и последовательно привести пользователя к записи. Информация раскрывается постепенно: от первого знакомства с продуктом до программы, отзывов, стоимости и ответов на вопросы.',
    done: [
      'структура Landing Page',
      'первый экран с основным предложением',
      'презентация специалиста',
      'описание практикума',
      'программа',
      'блоки с преимуществами',
      'отзывы',
      'информация об участии',
      'частые вопросы',
      'несколько точек перехода к целевому действию',
      'адаптация под мобильные устройства',
    ],
    accent: 'var(--lime-soft)',
  },
  {
    name: 'Дарья Антонова',
    domain: 'psychologistdarya.online',
    shot: '/portfolio/darya.jpg',
    url: 'https://psychologistdarya.online/',
    tag: 'Многостраничный сайт · UX/UI · Разработка · SEO',
    heading: 'Сайт частного психолога',
    lead: 'Многостраничный сайт специалиста для представления услуг психолога и развития проекта через органический поиск и полезный контент.',
    text: 'В отличие от одностраничного Landing Page здесь полноценная структура с отдельными направлениями работы, информацией о специалисте и блогом. Такой формат позволяет постепенно добавлять новые страницы услуг и материалы, не перестраивая весь проект.',
    done: [
      'главная страница',
      'информация о специалисте',
      'структура услуг',
      'отдельные направления работы',
      'блог',
      'информационные материалы',
      'контактный раздел',
      'удобные способы связи',
      'адаптация под мобильные устройства',
      'структура для дальнейшего SEO-развития',
    ],
    accent: 'var(--gray-soft)',
  },
];

// Список из голых существительных ничего не сообщает читателю: «структура
// страниц», «пользовательский путь» — это слова, которые есть у всех.
// За каждым пунктом стоит конкретный вопрос, и именно он показывает работу.
const factors = [
  {
    title: 'Задача проекта',
    text: 'Сайт должен продавать, собирать заявки, объяснять услугу или набирать поисковый трафик. Это разные сайты, и решать надо до дизайна, а не после.',
  },
  {
    title: 'Структура страниц',
    text: 'Сколько страниц нужно на старте и во что это вырастет через год. Лендинг, который придётся переделывать через полгода, дешевле сделать сразу сайтом.',
  },
  {
    title: 'Путь пользователя',
    text: 'Откуда человек приходит, что видит первым и сколько шагов до нужного действия. Каждый лишний шаг стоит части заявок.',
  },
  {
    title: 'Навигация',
    text: 'Понятно ли из меню, что на сайте есть. Если посетителю приходится догадываться, он уходит к тому, у кого догадываться не надо.',
  },
  {
    title: 'Мобильные',
    text: 'Больше половины визитов приходит с телефона. Мы проверяем сайт на узких экранах в процессе работы, а не после запуска.',
  },
  {
    title: 'Целевые действия',
    text: 'Что именно человек должен сделать и насколько это заметно. Кнопка, которую видно только внизу страницы, работает как её отсутствие.',
  },
  {
    title: 'Техническая реализация',
    text: 'Скорость загрузки, корректная вёрстка, работающие формы. Всё это влияет и на поведение людей, и на позиции в поиске.',
  },
  {
    title: 'Развитие после запуска',
    text: 'Можно ли добавить раздел или услугу, не переделывая сайт целиком. Заложить это дешевле, чем возвращаться потом.',
  },
  {
    title: 'SEO',
    text: 'Если органический поиск важен, семантика и структура закладываются на старте. Прикрутить их к готовому сайту можно, но дороже и хуже.',
  },
];

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Наши проекты — Valore Agency',
  description,
  url: canonical,
  hasPart: works.map((w) => ({
    '@type': 'WebSite',
    name: w.name,
    url: w.url,
    description: w.lead,
  })),
};
---

<Layout title={title} description={description} canonical={canonical}>
  <Breadcrumb items={[{ label: 'Главная', href: '/' }, { label: 'Наши проекты' }]} />

  <section class="hero hero--center">
    <div class="hero__blob hero__blob--lime"></div>
    <div class="hero__blob hero__blob--pink"></div>
    <div class="container hero__inner">
      <p class="eyebrow">Портфолио</p>
      <h1>Наши проекты</h1>
      <p class="hero__lead">
        Здесь мы показываем реальные запущенные сайты, над которыми работали: от Landing Page
        и сайтов специалистов до информационных проектов. Для каждого проекта рассказываем
        о его задаче, структуре и основных решениях.
      </p>
      <div class="hero__actions">
        <a href="https://t.me/Valoreagency" target="_blank" rel="nofollow noopener" class="btn btn--dark">Обсудить свой проект</a>
      </div>
    </div>
  </section>

  <section id="raboty">
    <div class="container">
      <p class="eyebrow">— Реализованные проекты</p>
      <h2 class="section-title">Сайты, которые уже работают</h2>

      <div class="cases">
        {
          works.map((w) => (
            <article class="case">
              <div class="case__cover" style={`background:${w.accent}`}>
                <img
                  class="case__shot"
                  src={w.shot}
                  width="640"
                  height="1120"
                  loading="lazy"
                  decoding="async"
                  alt={`Главная страница сайта ${w.domain}`}
                />
                <span class="case__badge">{w.domain}</span>
              </div>
              <div class="case__body">
                <span class="case__tag">{w.tag}</span>
                <h3 class="case__title">{w.heading}</h3>
                <p class="case__lead">{w.lead}</p>
                <p class="case__text">{w.text}</p>
                <p class="case__subtitle">Что реализовано</p>
                <ul class="case__list">
                  {w.done.map((d) => <li>{d}</li>)}
                </ul>
                <a href={w.url} class="btn btn--ghost case__btn" target="_blank" rel="noopener">
                  Посмотреть сайт →
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="prose">
    <div class="container">
      <h2 class="section-title">Разные проекты требуют разного подхода</h2>
      <p>
        У каждого сайта своя задача. Для <strong>Landing Page</strong> важно сфокусировать
        пользователя на одном предложении и последовательно привести его к целевому действию.
      </p>
      <p>
        Для <strong>сайта специалиста</strong> важна полноценная структура, которая позволяет
        представить несколько услуг, сформировать доверие и постепенно развивать проект через
        новые страницы и контент.
      </p>
      <p>
        Для <strong>информационного портала</strong> на первый план выходит масштабируемость:
        работа с большим количеством рубрик, публикаций и постоянно обновляемой информацией.
      </p>
      <p>
        Поэтому мы не используем одну универсальную структуру для всех проектов. Сначала
        определяем задачу будущего сайта, а затем подбираем подходящую архитектуру,
        функциональность и дизайн.
      </p>
    </div>
  </section>

  <section id="podhod">
    <div class="container">
      <p class="eyebrow">— Что мы учитываем при разработке</p>
      <h2 class="section-title">Сайт — это не только его внешний вид</h2>
      <ul class="reasons">
        {factors.map((f) => (
          <li>
            <strong>{f.title}</strong>
            <span>{f.text}</span>
          </li>
        ))}
      </ul>
      <p class="cases__note">
        Ни один из этих вопросов не виден на макете. Но именно из-за них сайт спустя год либо
        продолжает работать и расти, либо остаётся красивой картинкой, к которой никто
        не возвращается.
      </p>
    </div>
  </section>

  <section class="prose">
    <div class="container">
      <h2 class="section-title">Не нашли свою отрасль?</h2>
      <p>
        Это нормально. Портал об играх, сайт психолога и лендинг образовательного проекта
        сделаны по-разному не потому, что у них разные отрасли, а потому что у них разные
        задачи. Отрасль почти не влияет на то, как устроен сайт — влияет то, что он должен
        делать.
      </p>
      <p>
        Поэтому не ищите в портфолио проект из своей ниши. Посмотрите, какая из трёх задач
        ближе к вашей: собрать заявки на одной странице, представить специалиста и его услуги
        или растить контентный проект под поиск.
      </p>
      <p>
        Напишите, что нужно сделать и зачем — этого достаточно для первого разговора. Мы
        скажем, какой формат подходит и сколько это займёт, даже если в итоге вы решите
        делать не с нами. Как устроена работа по шагам — на странице
        <a href="/uslugi/sozdanie-sajtov/">создание сайтов</a>.
      </p>
    </div>
  </section>

  <ContactCta
    title="Обсудим ваш проект"
    lead="Расскажите, какой сайт вам нужен и какую задачу он должен решать — ответим и предложим вариант реализации."
  />

  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
</Layout>

<style>
  .cases {
    display: grid;
    gap: 24px;
  }
  .case {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    display: grid;
    grid-template-columns: 280px 1fr;
  }
  .case__cover {
    min-width: 0;
    position: relative;
    overflow: hidden;
    display: flex;
  }
  /* Скриншот прижат к верхнему краю: у сайтов самое узнаваемое — первый экран,
     и при обрезке терять надо низ, а не шапку. */
  .case__shot {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }
  .case__badge {
    position: absolute;
    left: 16px;
    bottom: 16px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(11, 18, 21, 0.78);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.01em;
    backdrop-filter: blur(4px);
  }
  .case__domain {
    font-family: 'Unbounded', sans-serif;
    font-weight: 600;
    font-size: 19px;
    line-height: 1.3;
    word-break: break-word;
    color: var(--ink);
  }
  .case__body {
    min-width: 0;
    padding: 28px;
  }
  .case__tag {
    display: block;
    font-size: 12px;
    color: var(--ink-60);
    margin-bottom: 10px;
  }
  .case__title {
    font-size: 21px;
    font-weight: 600;
    margin-bottom: 12px;
  }
  .case__lead {
    font-size: 15px;
    margin-bottom: 10px;
  }
  .case__text {
    font-size: 15px;
    color: var(--ink-60);
    margin-bottom: 20px;
  }
  .case__subtitle {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-60);
    margin-bottom: 10px;
  }
  .case__list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 22px;
  }
  .case__list li {
    font-size: 13px;
    color: var(--ink-60);
    background: var(--gray-soft);
    border-radius: 8px;
    padding: 6px 10px;
  }
  .case__btn {
    display: inline-block;
  }
  .cases__note {
    max-width: 720px;
    margin-top: 20px;
    font-size: 15px;
    color: var(--ink-60);
  }
  .reasons {
    max-width: 720px;
    list-style: none;
    display: grid;
    gap: 14px;
  }
  .reasons li strong {
    display: block;
    font-weight: 700;
    margin-bottom: 4px;
  }
  .reasons li span {
    display: block;
    color: var(--ink-60);
  }
  .reasons li {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 16px 20px 16px 44px;
    font-size: 15px;
    color: var(--ink-60);
    position: relative;
  }
  .reasons li::before {
    content: '✓';
    position: absolute;
    left: 18px;
    color: var(--lime);
    font-weight: 700;
    font-size: 16px;
  }

  @media (max-width: 860px) {
    .case {
      grid-template-columns: 1fr;
    }
    .case__cover {
      aspect-ratio: 16 / 10;
    }
    .case__body {
      padding: 24px;
    }
  }
</style>
