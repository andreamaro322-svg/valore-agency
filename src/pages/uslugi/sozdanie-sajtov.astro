---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ContactCta from '../../components/ContactCta.astro';

const title = 'Создание сайтов под ключ для бизнеса | Valore Agency';
const description =
  'Разработка сайтов под ключ для бизнеса: Landing Page, многостраничные, корпоративные и контентные сайты. Дизайн, разработка и SEO-подготовка.';
const canonical = 'https://valoreagency.net/uslugi/sozdanie-sajtov';

const TG = 'https://t.me/Valoreagency';

const types = [
  {
    name: 'Landing Page',
    text: 'Одностраничный сайт для продвижения конкретной услуги, продукта, специалиста, мероприятия или рекламной кампании. Структура выстраивается вокруг одной задачи: познакомить пользователя с предложением, ответить на его вопросы и привести к целевому действию.',
    forWhom: ['отдельных услуг', 'запуска нового продукта', 'экспертов и специалистов', 'рекламных кампаний', 'мероприятий', 'специальных предложений'],
    cta: 'Обсудить Landing Page',
    bg: 'var(--lime-soft)',
  },
  {
    name: 'Многостраничный сайт для специалиста или бизнеса',
    text: 'Сайт с отдельными страницами услуг, информацией о компании или специалисте, контактами и дополнительными разделами. Подходит, когда одной посадочной страницы недостаточно и нужно подробно представить несколько направлений работы. Структуру можно постепенно расширять новыми услугами, статьями и посадочными страницами.',
    forWhom: ['специалистов', 'малого и среднего бизнеса', 'локальных компаний', 'профессиональных услуг', 'сервисного бизнеса'],
    cta: 'Обсудить проект',
    bg: 'var(--pink-soft)',
  },
  {
    name: 'Корпоративный сайт',
    text: 'Полноценный сайт компании с несколькими направлениями деятельности и более сложной структурой. В проект могут входить отдельные страницы услуг, информация о компании, проекты или кейсы, блог, вакансии и другие разделы. Архитектуру продумываем с учётом дальнейшего развития и SEO-продвижения.',
    forWhom: [],
    cta: 'Обсудить корпоративный сайт',
    bg: 'var(--gray-soft)',
  },
  {
    name: 'Контентный и медиа-сайт',
    text: 'Сайты, рассчитанные на регулярную публикацию большого количества материалов: новостей, статей, обзоров и гайдов. В таких проектах особое внимание уделяем структуре категорий, навигации, внутренним страницам и возможности масштабирования.',
    forWhom: ['интернет-СМИ', 'тематических порталов', 'корпоративных блогов', 'информационных проектов', 'контентных сайтов'],
    cta: 'Обсудить медиа-проект',
    bg: 'var(--lime-soft)',
  },
];

const steps = [
  {
    n: '01',
    title: 'Обсуждаем задачу',
    text: 'Вы рассказываете о бизнесе, продукте и о том, какой результат хотите получить от сайта. Подробное техническое задание не требуется — достаточно описать задачу своими словами.',
  },
  {
    n: '02',
    title: 'Проектируем структуру',
    text: 'Определяем необходимые страницы, разделы и основные смысловые блоки. Если сайт планируется продвигать через SEO, учитываем поисковый спрос и направления дальнейшего развития.',
  },
  {
    n: '03',
    title: 'Создаём прототип и дизайн',
    text: 'Продумываем пользовательский путь, расположение элементов и визуальную концепцию. Дизайн создаётся с учётом тематики, аудитории и позиционирования проекта.',
  },
  {
    n: '04',
    title: 'Разрабатываем сайт',
    text: 'Переносим утверждённый дизайн в рабочий сайт, адаптируем страницы под мобильные устройства и подключаем необходимый функционал.',
  },
  {
    n: '05',
    title: 'Проверяем техническую часть',
    text: 'Перед запуском проверяем страницы, формы, мобильную версию и технические элементы. При необходимости настраиваем мета-данные, sitemap.xml, robots.txt и структурированную разметку.',
  },
  {
    n: '06',
    title: 'Запускаем проект',
    text: 'Проводим финальную проверку и публикуем сайт на рабочем домене. После запуска проект можно развивать: добавлять страницы, контент, функционал и заниматься SEO-продвижением.',
  },
];

const scope = [
  'анализ задачи и конкурентов',
  'проектирование структуры сайта',
  'прототипирование страниц',
  'UX/UI-дизайн',
  'адаптивную вёрстку',
  'разработку сайта',
  'настройку форм обратной связи',
  'подключение веб-аналитики',
  'базовую техническую SEO-подготовку',
  'настройку индексируемости',
  'мета-данные',
  'sitemap.xml и robots.txt',
  'подходящую микроразметку',
  'оптимизацию изображений',
  'публикацию сайта',
  'дальнейшую техническую поддержку',
];

const advantages = [
  {
    icon: '🧱',
    title: 'Сначала структура — потом дизайн',
    text: 'Мы не начинаем работу с красивой картинки. Сначала определяем задачу сайта, необходимую структуру и пользовательские сценарии, и только после этого переходим к визуальной части.',
  },
  {
    icon: '🔍',
    title: 'SEO можно заложить заранее',
    text: 'Если органический поиск — важный канал привлечения клиентов, SEO учитывается ещё на этапе проектирования сайта.',
  },
  {
    icon: '🤝',
    title: 'Одна команда',
    text: 'Структура, дизайн, разработка и SEO рассматриваются как части одного проекта, а не как отдельные несвязанные задачи.',
  },
  {
    icon: '🌱',
    title: 'Сайт можно развивать после запуска',
    text: 'Архитектуру строим так, чтобы проект можно было расширять новыми страницами, услугами, категориями и контентом.',
  },
  {
    icon: '📋',
    title: 'Понятный процесс',
    text: 'Перед началом разработки определяем задачу, необходимый функционал и этапы работы.',
  },
];

const priceFactors = [
  'тип сайта',
  'количество страниц',
  'сложность структуры',
  'объём дизайна',
  'необходимый функционал',
  'интеграции',
  'объём контента',
  'дополнительные технические задачи',
];

const faq = [
  {
    q: 'Сколько времени занимает разработка сайта?',
    a: 'Срок зависит от масштаба проекта. Landing Page можно реализовать значительно быстрее крупного многостраничного сайта или информационного портала. Точный срок определяем после того, как понимаем структуру и необходимый функционал.',
  },
  {
    q: 'Нужно ли мне готовить техническое задание?',
    a: 'Нет. Можно просто рассказать, чем занимается ваш бизнес, для чего нужен сайт и какой результат вы хотите получить. После этого мы поможем определить подходящий формат и структуру проекта.',
  },
  {
    q: 'Можно ли заказать сайт сразу с SEO?',
    a: 'Да. Если SEO планируется как один из каналов привлечения клиентов, лучше учитывать его ещё до разработки — это позволяет заранее продумать необходимые страницы и архитектуру сайта.',
  },
  {
    q: 'Можно ли заказать только дизайн или разработку?',
    a: 'Да. Возможность подключения к отдельному этапу проекта обсуждается индивидуально.',
  },
  {
    q: 'Сайт будет нормально работать на смартфонах?',
    a: 'Да. При разработке учитываем отображение и удобство использования сайта на смартфонах, планшетах и компьютерах.',
  },
  {
    q: 'Смогу ли я самостоятельно менять информацию на сайте?',
    a: 'Если самостоятельное редактирование контента является важным требованием, это учитывается при выборе технологии и разработке проекта.',
  },
  {
    q: 'Можно ли переделать существующий сайт?',
    a: 'Да. Сначала изучаем текущий проект и определяем, что стоит сохранить, а что необходимо переработать. Если сайт уже получает органический трафик, при переносе отдельно учитываем существующие URL и другие важные SEO-элементы.',
  },
  {
    q: 'Можно ли продолжить работу с сайтом после запуска?',
    a: 'Да. При необходимости можем добавлять новые страницы и функции, работать с технической частью, контентом и SEO-продвижением.',
  },
  {
    q: 'Как узнать стоимость моего проекта?',
    a: 'Напишите нам и коротко расскажите, какой сайт вам нужен. После обсуждения задачи мы сможем оценить необходимый объём работ, сроки и стоимость.',
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Разработка сайтов',
  name: 'Создание сайтов под ключ для бизнеса',
  provider: { '@type': 'Organization', name: 'Valore Agency', url: 'https://valoreagency.net/' },
  areaServed: 'RU',
  url: canonical,
  description,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Типы сайтов',
    itemListElement: types.map((t) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: t.name, description: t.text },
    })),
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout title={title} description={description} canonical={canonical}>
  <Breadcrumb
    items={[
      { label: 'Главная', href: '/' },
      { label: 'Услуги', href: '/#uslugi' },
      { label: 'Создание сайтов' },
    ]}
  />

  <section class="hero">
    <div class="hero__blob hero__blob--lime"></div>
    <div class="hero__blob hero__blob--pink"></div>
    <div class="container hero__inner">
      <p class="eyebrow">Услуга — Создание сайтов</p>
      <h1>Создание сайтов под ключ для бизнеса</h1>
      <p class="hero__lead">
        Проектируем и разрабатываем сайты, которые не просто хорошо выглядят, а решают задачи
        бизнеса: представляют услуги, помогают получать обращения и создают основу для
        дальнейшего продвижения. Структура, дизайн, разработка и техническая SEO-подготовка —
        в рамках одного проекта.
      </p>
      <div class="hero__actions">
        <a href={TG} target="_blank" rel="nofollow noopener" class="btn btn--dark">Обсудить проект</a>
        <a href="/portfolio" class="btn btn--ghost">Посмотреть наши проекты</a>
      </div>
    </div>
  </section>

  <section class="prose">
    <div class="container">
      <h2 class="section-title">Сайт должен решать задачу бизнеса</h2>
      <p>
        Красивого дизайна недостаточно. Пользователь должен быстро понять, чем занимается
        компания, что она предлагает и какое действие ему нужно сделать дальше. При этом сайт
        должен быть удобным на смартфоне, быстро загружаться и позволять бизнесу развивать его
        после запуска.
      </p>
      <p>
        Поэтому мы начинаем работу не с выбора шаблона или цвета кнопок. Сначала разбираемся
        в задаче проекта, изучаем бизнес и продумываем структуру будущего сайта. Только после
        этого переходим к прототипу, дизайну и разработке.
      </p>
    </div>
  </section>

  <section id="tipy">
    <div class="container">
      <p class="eyebrow">— Форматы</p>
      <h2 class="section-title">Какие сайты мы создаём</h2>
      <div class="types">
        {
          types.map((t) => (
            <article class="type" style={`background:${t.bg}`}>
              <h3 class="type__title">{t.name}</h3>
              <p class="type__text">{t.text}</p>
              {t.forWhom.length > 0 && (
                <>
                  <p class="type__subtitle">Подходит для</p>
                  <ul class="type__list">
                    {t.forWhom.map((f) => <li>{f}</li>)}
                  </ul>
                </>
              )}
              <a href={TG} target="_blank" rel="nofollow noopener" class="btn btn--ghost type__btn">
                {t.cta}
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="prose">
    <div class="container">
      <h2 class="section-title">SEO учитываем ещё до разработки</h2>
      <p>
        Распространённая ситуация: компания сначала создаёт сайт, а SEO-специалиста подключает
        уже после запуска. После анализа может оказаться, что для продвижения не хватает
        отдельных страниц услуг, необходимо менять структуру разделов, навигацию, URL или
        перерабатывать контент.
      </p>
      <p>
        Мы предлагаем учитывать SEO ещё на этапе проектирования. Если органический поиск важен
        для проекта, до начала дизайна определяем, какие страницы понадобятся сайту, как они
        должны быть связаны между собой и как структуру можно будет расширять в будущем.
      </p>
      <p>
        Это позволяет получить более понятную и масштабируемую архитектуру уже на момент
        запуска сайта. Подробнее об этом — на странице
        <a href="/uslugi/seo-geo-prodvizhenie">SEO и GEO-продвижение</a>.
      </p>
    </div>
  </section>

  <section id="etapy">
    <div class="container">
      <p class="eyebrow">— Процесс</p>
      <h2 class="section-title">Как проходит разработка сайта</h2>
      <div class="steps steps--6">
        {
          steps.map((s) => (
            <div class="step">
              <span class="step__n">{s.n}</span>
              <h3 class="step__title">{s.title}</h3>
              <p class="step__text">{s.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="sostav">
    <div class="container">
      <p class="eyebrow">— Объём работ</p>
      <h2 class="section-title">Что может входить в разработку</h2>
      <p class="lead-note">Конкретный состав работ зависит от проекта. Мы можем взять на себя:</p>
      <ul class="chips">
        {scope.map((s) => <li>{s}</li>)}
      </ul>
      <p class="lead-note">
        Перед началом работы определяем, какие именно задачи необходимы конкретному проекту.
      </p>
    </div>
  </section>

  <section id="pochemu">
    <div class="container">
      <p class="eyebrow">— Почему Valore Agency</p>
      <h2 class="section-title">Наш подход к разработке</h2>
      <div class="services">
        {
          advantages.map((a) => (
            <div class="service" style="background:var(--gray-soft)">
              <span class="service__icon" aria-hidden="true">{a.icon}</span>
              <h3 class="service__title">{a.title}</h3>
              <p class="service__text">{a.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="prose">
    <div class="container">
      <h2 class="section-title">Посмотрите наши проекты</h2>
      <p>
        Лучший способ оценить наш подход — посмотреть уже работающие сайты. В портфолио мы
        показываем реальные запущенные проекты: от Landing Page и сайтов специалистов до
        контентных порталов.
      </p>
      <p>
        <a href="/portfolio" class="btn btn--dark">Посмотреть наши проекты</a>
      </p>
    </div>
  </section>

  <section id="stoimost">
    <div class="container">
      <p class="eyebrow">— Стоимость</p>
      <h2 class="section-title">Как формируется стоимость сайта</h2>
      <p class="lead-note">Стоимость разработки рассчитывается индивидуально. На неё влияют:</p>
      <ul class="chips">
        {priceFactors.map((p) => <li>{p}</li>)}
      </ul>
      <p class="lead-note">
        Поэтому мы не используем универсальную цену для всех проектов. Сначала необходимо
        коротко обсудить задачу — после этого мы сможем предложить подходящий формат
        реализации и оценить стоимость и сроки работы.
      </p>
      <p>
        <a href={TG} target="_blank" rel="nofollow noopener" class="btn btn--dark">Обсудить проект</a>
      </p>
    </div>
  </section>

  <section id="faq">
    <div class="container">
      <p class="eyebrow">— Вопросы и ответы</p>
      <h2 class="section-title">Частые вопросы</h2>
      <div class="faq">
        {
          faq.map((item) => (
            <details class="faq__item">
              <summary class="faq__q">{item.q}</summary>
              <p class="faq__a">{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <ContactCta
    title="Есть проект или идея?"
    lead="Расскажите, какой сайт вам нужен и какую задачу он должен решать. Большое техническое задание не нужно — достаточно нескольких предложений о бизнесе или идее проекта."
  />

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>

<style>
  .types {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .type {
    border-radius: var(--radius);
    padding: 30px;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .type__title {
    font-size: 19px;
    font-weight: 600;
    margin-bottom: 12px;
  }
  .type__text {
    font-size: 15px;
    color: var(--ink-60);
    margin-bottom: 18px;
  }
  .type__subtitle {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-60);
    margin-bottom: 10px;
  }
  .type__list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }
  .type__list li {
    font-size: 13px;
    background: rgba(255, 255, 255, 0.72);
    border-radius: 8px;
    padding: 6px 10px;
  }
  .type__btn {
    margin-top: auto;
    align-self: flex-start;
  }
  .chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 18px 0 22px;
  }
  .chips li {
    font-size: 14px;
    color: var(--ink-60);
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 9px 14px;
  }
  .lead-note {
    max-width: 720px;
    font-size: 15px;
    color: var(--ink-60);
  }
  .steps--6 {
    grid-template-columns: repeat(3, 1fr);
  }

  @media (max-width: 860px) {
    .types,
    .steps--6 {
      grid-template-columns: 1fr;
    }
    .type {
      padding: 24px;
    }
  }
</style>
