---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ContactCta from '../components/ContactCta.astro';

const title = 'О Valore Agency — разработка сайтов и SEO-продвижение';
const description =
  'Valore Agency — digital-агентство: создание сайтов, SEO и GEO, аудит, поддержка и линкбилдинг. Рассказываем о нашем подходе и принципах работы.';
const canonical = 'https://valoreagency.net/o-nas/';

const TG = 'https://t.me/Valoreagency';

const services = [
  {
    icon: '🚀',
    title: 'Создание сайтов',
    text: 'Проектируем Landing Page, многостраничные сайты для бизнеса и специалистов, корпоративные и контентные проекты. Работу начинаем со структуры и задачи сайта, а не с готового шаблона.',
    href: '/uslugi/sozdanie-sajtov',
    more: 'Подробнее о создании сайтов',
    bg: 'var(--lime-soft)',
  },
  {
    icon: '🔍',
    title: 'SEO и GEO',
    text: 'Работаем над видимостью сайта в классическом поиске и учитываем то, как контент воспринимается современными поисковыми и AI-системами. Занимаемся технической оптимизацией, структурой, семантикой и контентом.',
    href: '/uslugi/seo-geo-prodvizhenie',
    more: 'Подробнее о SEO и GEO',
    bg: 'var(--pink-soft)',
  },
  {
    icon: '🩺',
    title: 'Аудит сайтов',
    text: 'Анализируем техническое состояние сайта, структуру, SEO и другие проблемы, которые могут мешать его развитию. По итогам формируем конкретный список проблем и рекомендаций по их исправлению.',
    href: '/uslugi/audit-sajtov',
    more: 'Подробнее об аудите',
    bg: 'var(--gray-soft)',
  },
  {
    icon: '🛠️',
    title: 'Поддержка сайтов',
    text: 'Помогаем поддерживать уже работающие проекты: исправлять ошибки, обновлять страницы, добавлять функциональность и решать технические задачи.',
    href: '/uslugi/podderzhka-sajtov',
    more: 'Подробнее о поддержке',
    bg: 'var(--lime-soft)',
  },
  {
    icon: '🔗',
    title: 'Линкбилдинг',
    text: 'Занимаемся внешним продвижением сайтов и работой со ссылочным профилем проекта. Подбираем площадки с учётом тематики, качества сайта и задач конкретного проекта.',
    href: '/uslugi/linkbilding',
    more: 'Подробнее о линкбилдинге',
    bg: 'var(--pink-soft)',
  },
  {
    icon: '✳️',
    title: 'Разработка логотипов',
    text: 'Создаём логотипы и базовые визуальные решения для новых и существующих проектов. Отдельной страницы под эту услугу нет — расскажите о задаче, и мы обсудим её вместе с остальным проектом.',
    href: null,
    more: null,
    bg: 'var(--gray-soft)',
  },
];

const principles = [
  {
    title: 'Сначала задача — потом инструменты',
    text: 'Мы не предлагаем услугу только потому, что она есть в нашем списке. Сначала стараемся понять, что необходимо проекту: новый сайт, переработка существующего, SEO, аудит или отдельная техническая доработка.',
  },
  {
    title: 'Структура важнее красивой картинки',
    text: 'Дизайн важен, но сам по себе он не решает задачу бизнеса. При разработке сайта сначала продумываем страницы, навигацию, пользовательский путь и целевые действия, а затем переходим к визуальной части.',
  },
  {
    title: 'SEO лучше учитывать заранее',
    text: 'Если сайт планируется продвигать через органический поиск, структуру под SEO лучше продумать ещё до разработки. Это снижает вероятность того, что сайт придётся серьёзно перестраивать после запуска.',
  },
  {
    title: 'Не усложняем без необходимости',
    text: 'Не каждому проекту нужен сложный сайт, десятки интеграций или большой набор услуг. Если задачу можно решить проще, мы предпочитаем более понятное и практичное решение.',
  },
  {
    title: 'Прозрачно обсуждаем объём работы',
    text: 'До начала проекта определяем основную задачу, необходимый объём работ и ожидаемый результат. Стоимость и сроки зависят от конкретного проекта и обсуждаются после того, как понятна задача.',
  },
  {
    title: 'Думаем о развитии после запуска',
    text: 'Сайт редко заканчивается в момент публикации. Со временем появляются новые услуги, страницы, статьи, интеграции и задачи по продвижению. Поэтому создаём структуру, которую можно развивать без полной перестройки проекта.',
  },
];

const steps = [
  { n: '01', title: 'Разбираемся в задаче', text: 'Вы рассказываете о проекте и желаемом результате. Для первого разговора не требуется подробное техническое задание.' },
  { n: '02', title: 'Предлагаем решение', text: 'Определяем, какие работы действительно нужны и какой подход будет оптимальным.' },
  { n: '03', title: 'Согласовываем объём', text: 'До начала работы обсуждаем задачи, стоимость и сроки.' },
  { n: '04', title: 'Реализуем проект', text: 'Работаем по согласованному плану и остаёмся на связи по ходу выполнения задачи.' },
  { n: '05', title: 'Продолжаем развитие', text: 'После завершения основной работы можем подключиться к поддержке, SEO и дальнейшему развитию сайта. Клиент не обязан оставаться с нами после запуска.' },
];

const faq = [
  {
    q: 'С какими проектами вы работаете?',
    a: 'Работаем как с новыми проектами, которые только запускаются, так и с уже существующими сайтами. Это может быть разработка нового сайта, SEO-продвижение, аудит, техническая доработка или отдельная задача.',
  },
  {
    q: 'Обязательно ли заказывать сразу несколько услуг?',
    a: 'Нет. Можно обратиться за одной конкретной услугой — например, заказать только аудит, разработку сайта, SEO или техническую поддержку. Если проекту требуется комплексная работа, предложим подходящий вариант после обсуждения задачи.',
  },
  {
    q: 'Нужно ли готовить техническое задание перед обращением?',
    a: 'Нет. На первом этапе достаточно рассказать своими словами, что у вас есть сейчас и какой результат вы хотите получить. Если для проекта потребуется подробное техническое задание, его можно сформировать после обсуждения.',
  },
  {
    q: 'Как формируется стоимость?',
    a: 'Стоимость рассчитывается индивидуально и зависит от задачи, объёма работы и сложности проекта. Сначала мы уточняем детали, после чего можем оценить стоимость и сроки.',
  },
  {
    q: 'Можно ли обратиться с уже существующим сайтом?',
    a: 'Да. Не обязательно создавать новый сайт с нуля. Можем проанализировать существующий проект, провести аудит, исправить отдельные проблемы, заняться SEO или дальнейшим развитием сайта.',
  },
  {
    q: 'Работаете ли вы только с SEO и разработкой сайтов?',
    a: 'Это основные направления, но не единственные. Также занимаемся аудитами, поддержкой сайтов, линкбилдингом и разработкой логотипов.',
  },
  {
    q: 'Можно ли после создания сайта продолжить работу с вами?',
    a: 'Да. После запуска можем подключиться к SEO, технической поддержке, развитию структуры и другим задачам. При этом дальнейшее сопровождение не является обязательным.',
  },
];

const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: title,
  description,
  url: canonical,
  mainEntity: {
    '@type': 'Organization',
    name: 'Valore Agency',
    url: 'https://valoreagency.net/',
    description:
      'Digital-агентство: создание сайтов, SEO и GEO-продвижение, аудит, поддержка сайтов, линкбилдинг и разработка логотипов.',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout title={title} description={description} canonical={canonical}>
  <Breadcrumb items={[{ label: 'Главная', href: '/' }, { label: 'О нас' }]} />

  <section class="hero hero--center">
    <div class="hero__blob hero__blob--lime"></div>
    <div class="hero__blob hero__blob--pink"></div>
    <div class="container hero__inner">
      <p class="eyebrow">О компании</p>
      <h1>Valore Agency — сайты и продвижение в одной системе</h1>
      <p class="hero__lead">
        Создаём и развиваем digital-проекты: проектируем сайты, занимаемся SEO, аудитом,
        поддержкой и другими задачами, необходимыми для развития бизнеса в интернете.
        Наша основная идея проста: сайт, его структура, техническая часть, контент и
        продвижение должны работать вместе, а не существовать как отдельные несвязанные задачи.
      </p>
      <div class="hero__actions">
        <a href={TG} target="_blank" rel="nofollow noopener" class="btn btn--dark">Обсудить проект</a>
        <a href="/portfolio" class="btn btn--ghost">Посмотреть наши проекты</a>
      </div>
    </div>
  </section>

  <section class="prose">
    <div class="container">
      <h2 class="section-title">О Valore Agency</h2>
      <p>
        <strong>Valore Agency</strong> — digital-агентство, которое объединяет разработку
        сайтов и поисковое продвижение. Мы можем создать новый проект с нуля, подключиться
        к развитию существующего сайта или решить отдельную задачу: провести аудит,
        доработать техническую часть, заняться SEO, поддержкой или ссылочным продвижением.
      </p>
      <p>
        Нам близок системный подход. Мы стараемся сначала понять, какую задачу должен решать
        сайт или конкретная услуга, а уже после этого выбирать инструменты.
      </p>
      <p>
        Если создаём новый сайт и SEO будет важным каналом привлечения клиентов, учитываем
        это ещё при проектировании структуры. Если работаем с существующим проектом —
        сначала изучаем его состояние и только потом предлагаем изменения.
      </p>
    </div>
  </section>

  <section id="uslugi">
    <div class="container">
      <p class="eyebrow">— Направления</p>
      <h2 class="section-title">Чем мы занимаемся</h2>
      <div class="services">
        {
          services.map((s) => (
            <div class="service" style={`background:${s.bg}`}>
              <span class="service__icon" aria-hidden="true">{s.icon}</span>
              <h3 class="service__title">{s.title}</h3>
              <p class="service__text">{s.text}</p>
              {s.href && (
                <a href={s.href} class="service__more">
                  {s.more} →
                </a>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="printsipy">
    <div class="container">
      <p class="eyebrow">— Как мы работаем</p>
      <h2 class="section-title">Наши принципы</h2>
      <div class="services services--2col">
        {
          principles.map((p) => (
            <div class="principle">
              <h3 class="service__title">{p.title}</h3>
              <p class="service__text">{p.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="process">
    <div class="container">
      <p class="eyebrow">— Процесс</p>
      <h2 class="section-title">Как мы строим работу</h2>
      <div class="steps steps--5">
        {
          steps.map((s) => (
            <div class="step">
              <span class="step__n">{s.n}</span>
              <h3 class="step__title">{s.title}</h3>
              <p class="step__text">{s.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="prose">
    <div class="container">
      <h2 class="section-title">Посмотрите наши проекты</h2>
      <p>
        В портфолио мы показываем реальные запущенные сайты, которые можно открыть и
        посмотреть самостоятельно. Сейчас среди наших работ представлены Landing Page,
        многостраничный сайт специалиста и контентный информационный проект. По мере
        завершения новых проектов портфолио будет пополняться.
      </p>
      <p>
        <a href="/portfolio" class="btn btn--dark">Посмотреть наши проекты</a>
      </p>
    </div>
  </section>

  <section id="faq">
    <div class="container">
      <p class="eyebrow">— Вопросы и ответы</p>
      <h2 class="section-title">Частые вопросы о Valore Agency</h2>
      <div class="faq">
        {
          faq.map((item) => (
            <details class="faq__item">
              <summary class="faq__q">{item.q}</summary>
              <p class="faq__a">{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <ContactCta
    title="Давайте обсудим вашу задачу"
    lead="Нужен новый сайт, развитие существующего проекта, SEO или отдельная digital-задача — напишите нам. Достаточно коротко рассказать, что необходимо сделать."
  />

  <script type="application/ld+json" set:html={JSON.stringify(aboutSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>

<style>
  .principle {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 28px;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .steps--5 {
    grid-template-columns: repeat(5, 1fr);
  }

  @media (max-width: 1024px) {
    .steps--5 {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .steps--5 {
      grid-template-columns: 1fr;
    }
  }
</style>
