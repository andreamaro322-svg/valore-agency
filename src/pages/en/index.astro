---
import Layout from '../../layouts/Layout.astro';
import ContactCta from '../../components/ContactCta.astro';
import { usd } from '../../data/prices';

const services = [
  {
    icon: '🚀',
    title: 'Web development',
    text: 'Turnkey landing pages, small business websites and corporate websites — fast, responsive and ready for promotion.',
    href: '/en/services/web-development/',
    bg: 'var(--lime-soft)',
  },
  {
    icon: '🔍',
    title: 'SEO and GEO',
    text: 'Top Google rankings for your target keywords plus visibility in AI answers: ChatGPT, Gemini and other assistants.',
    href: '/en/services/seo-geo/',
    bg: 'var(--pink-soft)',
  },
  {
    icon: '🩺',
    title: 'Website audit',
    text: 'We find technical and SEO issues, show growth opportunities and give you a fix plan.',
    href: '/en/services/website-audit/',
    bg: 'var(--gray-soft)',
  },
  {
    icon: '✳️',
    title: 'Logo design',
    text: 'A logo and basic visual identity for new and existing projects — on its own or together with a website.',
    href: '#contact',
    bg: 'var(--lime-soft)',
  },
  {
    icon: '🛠️',
    title: 'Website support',
    text: 'Updates, improvements, monitoring and technical support — your website keeps running without failures.',
    href: '/en/services/website-support/',
    bg: 'var(--pink-soft)',
  },
  {
    icon: '🔗',
    title: 'Link building',
    text: 'We build a quality backlink profile, increasing domain authority and search rankings.',
    href: '/en/services/link-building/',
    bg: 'var(--gray-soft)',
  },
];

const steps = [
  { n: '01', title: 'Request and consultation', text: 'We discuss your task, goals and project scope.' },
  { n: '02', title: 'Contract and plan', text: 'We fix the timeline, price and project stages.' },
  { n: '03', title: 'Project work', text: 'Design, development and search optimization.' },
  { n: '04', title: 'Launch and reporting', text: 'We publish, hand over the project and report on results.' },
];

const pricing = [
  { name: 'Landing page', price: `from ${usd('landing')}`, text: 'A single-page website with one goal — a lead or a sale.' },
  { name: 'Brochure website', price: `from ${usd('businessCard')}`, text: 'A compact website to present your company or yourself.' },
  { name: 'Corporate website', price: `from ${usd('corporate')}`, text: 'A multi-page website of up to 10 pages with services and sections.' },
  { name: 'Large company website', price: `from ${usd('company')}`, text: 'A website of 10+ pages for a complex business structure and branches.' },
];

const faq = [
  {
    q: 'How much does a website cost?',
    a: `It depends on the type of website: a landing page starts at ${usd('landing')}, a brochure website at ${usd('businessCard')}, a corporate website of up to 10 pages at ${usd('corporate')}, and a company website of 10+ pages at ${usd('company')}. We give you the exact price after discussing your goals in a free consultation.`,
  },
  {
    q: 'What is GEO and how is it different from SEO?',
    a: 'SEO gets your website to the top of regular Google search results. GEO (Generative Engine Optimization) makes AI assistants such as ChatGPT and Gemini recommend and cite you. We do both.',
  },
  {
    q: 'How long does it take to build a website?',
    a: 'A landing page takes 3 to 7 days, a brochure website 5 to 10 days, a corporate website from 2 weeks. We fix the exact timeline in the contract depending on the scope.',
  },
  {
    q: 'Will I be able to edit the website myself after handover?',
    a: 'Yes. We hand over all access and, if needed, show you how to work with the website. You can also sign up for our support service, and we will make the edits for you.',
  },
  {
    q: 'Do you design logos and brand identity?',
    a: 'Yes, logo and brand identity design is a separate service. We can do it on its own or together with a website.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout>
  <!-- HERO -->
  <section class="hero">
    <div class="hero__blob hero__blob--lime"></div>
    <div class="hero__blob hero__blob--pink"></div>
    <div class="container hero__inner">
      <p class="eyebrow">Valore Agency — full-cycle digital agency</p>
      <h1>Websites that get found in search and in AI answers</h1>
      <p class="hero__lead">
        We build websites, get them to the top of Google and make them visible to AI assistants.
        One team for the whole cycle — from idea to a steady flow of leads.
      </p>
      <div class="hero__actions">
        <a href="#contact" class="btn btn--dark">Discuss a project</a>
        <a href="#services" class="btn btn--ghost">See services</a>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section id="services">
    <div class="container">
      <p class="eyebrow">— What we do</p>
      <h2 class="section-title">Your full online presence, end to end</h2>
      <div class="services">
        {
          services.map((s) => (
            <a class="service" href={s.href} style={`background:${s.bg}`}>
              <span class="service__icon" aria-hidden="true">{s.icon}</span>
              <h3 class="service__title">{s.title}</h3>
              <p class="service__text">{s.text}</p>
              <span class="service__more">Learn more →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section id="how-we-work">
    <div class="container">
      <p class="eyebrow">— How we work</p>
      <h2 class="section-title">Our process</h2>
      <div class="steps">
        {
          steps.map((step) => (
            <div class="step">
              <span class="step__n">{step.n}</span>
              <h3 class="step__title">{step.title}</h3>
              <p class="step__text">{step.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section id="pricing">
    <div class="container">
      <p class="eyebrow">— Transparent pricing</p>
      <h2 class="section-title">Website development pricing</h2>
      <div class="pricing">
        {
          pricing.map((p) => (
            <div class="price-card">
              <h3 class="price-card__name">{p.name}</h3>
              <div class="price-card__price">{p.price}</div>
              <p class="price-card__text">{p.text}</p>
              <a href="#contact" class="btn btn--ghost price-card__btn">Order</a>
            </div>
          ))
        }
      </div>
      <p class="pricing__note">
        We quote SEO, GEO, audits, logo design, support and link building individually
        after a consultation.
      </p>
    </div>
  </section>

  <!-- SEO TEXT -->
  <section id="about-services" class="seo-text">
    <div class="container">
      <h2 class="section-title">Turnkey website development and promotion</h2>
      <p>
        <strong>Valore Agency</strong> is a full-cycle digital agency. We build turnkey websites,
        promote them with SEO and GEO, run audits, design logos, and provide website support and
        link building. Instead of several contractors, you work with one team that is responsible
        for the result — from the first line of code to a steady flow of leads.
      </p>
      <p>
        We build <strong>business websites</strong> of any complexity: high-converting landing
        pages, brochure websites and multi-page corporate websites. Every project is designed for
        search promotion from day one — with a clean semantic structure, fast loading, responsive
        layout and correct structured data. A website like that gets indexed quickly, ranks high in
        Google and brings targeted traffic.
      </p>
      <p>
        A separate line of work is <strong>GEO — visibility in AI assistants</strong>. More and
        more people look for contractors not in search but through ChatGPT and Gemini. We structure
        your content so that AI models can find, understand and recommend you. We combine this with
        classic SEO, link building to grow domain authority, and ongoing support so your website
        keeps working and growing.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq">
    <div class="container">
      <p class="eyebrow">— Questions and answers</p>
      <h2 class="section-title">Frequently asked questions</h2>
      <div class="faq">
        {
          faq.map((item) => (
            <details class="faq__item">
              <summary class="faq__q">{item.q}</summary>
              <p class="faq__a">{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <ContactCta lang="en" />

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>

<style>
  .section-title {
    font-size: clamp(24px, 4vw, 32px);
    font-weight: 600;
    margin-bottom: 28px;
  }

  /* HERO */
  .hero {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding: 80px 0 64px;
  }
  .hero__blob {
    position: absolute;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.45;
    pointer-events: none;
  }
  .hero__blob--lime {
    background: var(--lime);
    top: -100px;
    left: -40px;
  }
  .hero__blob--pink {
    background: var(--pink);
    top: -60px;
    right: -30px;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: 640px;
  }
  .hero h1 {
    font-size: clamp(32px, 6vw, 46px);
    font-weight: 600;
    margin-top: 4px;
  }
  .hero__lead {
    max-width: 500px;
    margin: 20px auto 0;
    font-size: 17px;
    color: var(--ink-60);
  }
  .hero__actions {
    margin-top: 32px;
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* SERVICES */
  .services {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .service {
    border-radius: var(--radius);
    padding: 28px;
    min-height: 190px;
    display: flex;
    flex-direction: column;
    transition: transform 0.18s ease;
  }
  .service:hover {
    transform: translateY(-4px);
  }
  .service__icon {
    font-size: 30px;
    margin-bottom: 12px;
  }
  .service__title {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .service__text {
    font-size: 13.5px;
    color: var(--ink-60);
    flex-grow: 1;
  }
  .service__more {
    margin-top: 14px;
    font-size: 13px;
    font-weight: 600;
  }

  /* STEPS */
  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .step {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 26px;
  }
  .step__n {
    font-family: 'Unbounded', sans-serif;
    font-size: 30px;
    font-weight: 600;
    color: var(--lime);
    display: block;
    margin-bottom: 12px;
  }
  .step__title {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .step__text {
    font-size: 13.5px;
    color: var(--ink-60);
  }

  /* PRICING */
  .pricing {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .price-card {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 30px;
    display: flex;
    flex-direction: column;
  }
  .price-card__name {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 10px;
  }
  .price-card__price {
    font-family: 'Unbounded', sans-serif;
    font-size: 26px;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 12px;
  }
  .price-card__text {
    font-size: 13.5px;
    color: var(--ink-60);
    flex-grow: 1;
    margin-bottom: 20px;
  }
  .price-card__btn {
    align-self: flex-start;
  }
  .pricing__note {
    margin-top: 20px;
    font-size: 14px;
    color: var(--ink-60);
  }

  /* SEO TEXT */
  .seo-text .container {
    max-width: 820px;
  }
  .seo-text p {
    font-size: 16px;
    color: var(--ink-60);
    margin-bottom: 16px;
  }
  .seo-text strong {
    color: var(--ink);
    font-weight: 600;
  }

  /* FAQ */
  .faq {
    max-width: 820px;
  }
  .faq__item {
    border-bottom: 1px solid var(--border);
    padding: 4px 0;
  }
  .faq__q {
    font-family: 'Unbounded', sans-serif;
    font-size: 16px;
    font-weight: 500;
    padding: 18px 0;
    cursor: pointer;
    list-style: none;
    position: relative;
    padding-right: 32px;
  }
  .faq__q::-webkit-details-marker {
    display: none;
  }
  .faq__q::after {
    content: '+';
    position: absolute;
    right: 4px;
    top: 16px;
    font-size: 22px;
    color: var(--lime);
    transition: transform 0.2s ease;
  }
  .faq__item[open] .faq__q::after {
    transform: rotate(45deg);
  }
  .faq__a {
    font-size: 15px;
    color: var(--ink-60);
    padding: 0 32px 20px 0;
  }

  /* CTA */
  .cta__inner {
    position: relative;
    background: var(--dark);
    border-radius: 28px;
    padding: 56px 40px;
    overflow: hidden;
    text-align: center;
  }
  .cta__blob {
    position: absolute;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: var(--lime);
    filter: blur(90px);
    opacity: 0.35;
    top: -120px;
    right: -60px;
    pointer-events: none;
  }
  .cta__content {
    position: relative;
    z-index: 1;
    max-width: 520px;
    margin: 0 auto;
  }
  .cta .section-title {
    color: #fff;
  }
  .cta__lead {
    color: rgba(255, 255, 255, 0.7);
    font-size: 16px;
    margin-bottom: 28px;
  }
  .contacts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  .contact {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px 18px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #fff;
    font-size: 15px;
    font-weight: 600;
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .contact:hover {
    background: var(--lime);
    color: var(--dark);
    transform: translateY(-2px);
  }
  .contact:focus-visible {
    outline: 2px solid var(--lime);
    outline-offset: 2px;
  }
  .contact__icon {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
  }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    .services,
    .pricing {
      grid-template-columns: repeat(2, 1fr);
    }
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .services,
    .pricing,
    .steps {
      grid-template-columns: 1fr;
    }
    .cta__inner {
      padding: 40px 24px;
    }
  }
</style>
