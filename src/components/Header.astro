---
import { alternates, ui, type Lang } from '../i18n';

const { lang = 'ru' } = Astro.props as { lang?: Lang };
const t = ui[lang];

// Переключатель ведёт на ту же страницу на другом языке; если пары нет —
// на главную другого языка.
const other: Lang = lang === 'ru' ? 'en' : 'ru';
const switchHref = alternates(Astro.url.pathname)?.[other] ?? ui[other].home;
---

<header class="header">
  <div class="container header__inner">
    <a href={t.home} class="logo" aria-label={t.logoLabel}>
      Valore<span>.</span>
    </a>

    <nav class="nav" aria-label={t.navLabel}>
      {t.nav.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <a
      href={switchHref}
      class="lang-switch"
      hreflang={other}
      lang={other}
      aria-label={t.switchLabel}
      data-lang-switch={other}
    >
      {t.switchText}
    </a>

    <a href={`#${t.contactId}`} class="btn btn--lime header__cta">{t.headerCta}</a>
  </div>
</header>

<script>
  // Ручной выбор языка запоминается на год. Edge Function на главной
  // (netlify/edge-functions/lang-redirect.ts) видит cookie и больше не
  // перенаправляет человека по IP и языку браузера.
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((link) => {
    link.addEventListener('click', () => {
      document.cookie = `lang=${link.dataset.langSwitch}; path=/; max-age=31536000; samesite=lax`;
    });
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(247, 247, 244, 0.9);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .header__inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 64px;
  }
  .logo {
    font-family: 'Unbounded', sans-serif;
    font-weight: 700;
    font-size: 22px;
  }
  .logo span {
    color: var(--lime);
  }
  .nav {
    display: flex;
    gap: 20px;
    margin-left: 8px;
    font-size: 14px;
    color: var(--ink-60);
  }
  .nav a {
    transition: color 0.15s ease;
  }
  .nav a:hover {
    color: var(--ink);
  }
  .lang-switch {
    margin-left: auto;
    margin-right: -12px;
    padding: 7px 11px;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--ink-60);
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .lang-switch:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  .header__cta {
    padding: 9px 16px;
    font-size: 13px;
  }

  @media (max-width: 900px) {
    .nav {
      display: none;
    }
  }
</style>
